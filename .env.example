# Copy to .env and fill in. Never commit .env.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Data center hosts. India: .in  |  US: .com  |  EU: .eu  |  AU: .com.au
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_MAIL_API=https://mail.zoho.in/api
ZOHO_ACCOUNT_ID=

# Optional. Default sender; if unset, the account's primary address is looked up.
# ZOHO_FROM_ADDRESS=
# Optional. Where downloaded attachments are saved (default ~/Downloads/zoho-mail-attachments).
# ZOHO_DOWNLOAD_DIR=
# Optional. Set to true to let zoho_delete_email permanently delete (expunge) instead of moving to Trash.
# ZOHO_ALLOW_PERMANENT_DELETE=false
